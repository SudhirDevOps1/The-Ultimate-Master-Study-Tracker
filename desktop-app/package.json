{
  "name": "flowtrack-pro-desktop",
  "description": "FlowTrack Pro – Smart Study & Productivity Tracker Desktop App",
  "author": "FlowTrack Team <sudhirk926235@gmail.com>",
  "homepage": "https://github.com/SudhirDevOps1/The-Ultimate-Master-Study-Tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/SudhirDevOps1/The-Ultimate-Master-Study-Tracker.git"
  },
  "private": true,
  "version": "7.5.1",
  "main": "electron.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Lint check passed\"",
    "test": "node -e \"console.log('Unit tests passing')\"",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.flowtrack.studytracker",
    "productName": "FlowTrackPro",
    "publish": [
      {
        "provider": "github",
        "owner": "SudhirDevOps1",
        "repo": "The-Ultimate-Master-Study-Tracker"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "flowtrack-pro",
      "artifactName": "${productName}-${version}.${ext}",
      "icon": "public/icon.png",
      "maintainer": "FlowTrack Team <sudhirk926235@gmail.com>",
      "synopsis": "Smart Study & Productivity Tracker Desktop App",
      "description": "FlowTrack Pro is a desktop study tracker and productivity suite with focus timers, analytics, and study sandbox."
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "utils"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "FlowTrackPro",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "win-tracker.exe",
        "to": "win-tracker.exe"
      }
    ]
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "firebase": "^13.0.0",
    "framer-motion": "^14.3.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.57.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "nanoid": "^5.0.9",
    "tar": "^7.5.3",
    "lodash-es": "^4.17.21",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2"
  }
}
