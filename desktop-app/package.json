{
  "name": "flowtrack-pro-desktop",
  "description": "FlowTrack Pro – Smart Study & Productivity Tracker Desktop App",
  "author": "FlowTrack Community <https://github.com/SudhirDevOps1>",
  "homepage": "https://github.com/SudhirDevOps1/The-Ultimate-Master-Study-Tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/SudhirDevOps1/The-Ultimate-Master-Study-Tracker.git"
  },
  "private": true,
  "version": "0.2.4",
  "main": "electron.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run src/__tests__/e2e/",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.flowtrack.studytracker",
    "productName": "FlowTrackPro",
    "publish": [
      {
        "provider": "github",
        "owner": "SudhirDevOps1",
        "repo": "The-Ultimate-Master-Study-Tracker"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "flowtrack-pro",
      "artifactName": "${productName}-${version}.${ext}",
      "icon": "public/icon.png",
      "maintainer": "FlowTrack Community <https://github.com/SudhirDevOps1>",
      "synopsis": "Smart Study & Productivity Tracker Desktop App",
      "description": "FlowTrack Pro is a desktop study tracker and productivity suite with focus timers, analytics, and study sandbox."
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "utils"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "FlowTrackPro",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron.js",
      "preload.js",
      "adBlockList.js",
      "electron-main/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "win-tracker.exe",
        "to": "win-tracker.exe"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@mozilla/readability": "^0.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/dompurify": "^3.0.5",
    "clsx": "2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dexie-export-import": "^4.1.4",
    "dompurify": "^3.2.4",
    "electron-chrome-extensions": "4.10.0",
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.35.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.474.0",
    "mermaid": "^12.2.0",
    "minisearch": "^7.1.2",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.5",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "nanoid": "^5.0.9",
    "tar": "^7.5.3",
    "lodash-es": "^4.17.21",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2"
  }
}
