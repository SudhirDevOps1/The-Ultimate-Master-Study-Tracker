{
  "name": "flowtrack-pro-desktop",
  "description": "FlowTrack Pro – Smart Study & Productivity Tracker Desktop App",
  "author": "FlowTrack Team",
  "private": true,
  "version": "7.3.1",
  "main": "electron.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.flowtrack.studytracker",
    "productName": "FlowTrackPro",
    "publish": [
      {
        "provider": "github",
        "owner": "SudhirDevOps1",
        "repo": "The-Ultimate-Master-Study-Tracker"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "FlowTrackPro",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "win-tracker.exe",
        "to": "win-tracker.exe"
      }
    ]
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.35.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.474.0",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "nanoid": "^5.0.9",
    "tar": "^7.5.3",
    "lodash-es": "^4.17.21",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2"
  }
}
