{
  "name": "flowtrack-workspace",
  "private": true,
  "version": "0.5.0",
  "scripts": {
    "sync:apps": "node scripts/sync-codebase.mjs",
    "check:parity": "node scripts/check-app-parity.mjs",
    "build": "node scripts/sync-codebase.mjs && cd web-app && npm install --legacy-peer-deps && npm run build",
    "dev": "cd web-app && npm run dev",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "release": "release-please release-pr --config-file=release-please-config.json --manifest-file=.release-please-manifest.json",
    "sync:version": "node scripts/sync-version.mjs",
    "bump:version": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7"
  }
}
